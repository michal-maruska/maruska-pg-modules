foto_img2

perl code:



my ($numero,$name,$h,$w)=@_;



my $x,$y; # x <---->

my $max=200;
my $postfix="/2";

if (($w==0) || ($h==0)) {return ''};

if ($w>$h){
        $x= $max;
        $y=int($h*$max/$w);
        }
else {
        $x=int($w*$max/$h);
        $y=$max;
        };

return '<img src="/f/'.
        $numero.
        '/'.
        $name.
        '/t'.$postfix.'" width="'.
        $x.
        '" height="'.
        $y.
        '">';
 | foto_img2
